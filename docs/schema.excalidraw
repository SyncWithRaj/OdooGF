      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN1t",
      "roundness": null,
      "seed": 1148015913,
      "version": 411,
      "versionNonce": 827014722,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777165,
      "link": null,
      "locked": false,
      "text": "Here we distribute req equally among present servers so if a server is powerful, \nwe cannot utilize it's full potential so that's disadvantage here in RR overcome by WRR",
      "fontSize": 18.33788164516578,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we distribute req equally among present servers so if a server is powerful, \nwe cannot utilize it's full potential so that's disadvantage here in RR overcome by WRR",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ceYe1gTwqiJWFiMFNNXQr",
      "type": "text",
      "x": 10242.771141538044,
      "y": 2106.665413661524,
      "width": 787.3811465188998,
      "height": 22.922352056457225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN1u",
      "roundness": null,
      "seed": 2088841577,
      "version": 613,
      "versionNonce": 1254112990,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777165,
      "link": null,
      "locked": false,
      "text": "Wherever least connections are there the new request routed to that Server",
      "fontSize": 18.33788164516578,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wherever least connections are there the new request routed to that Server",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e4XYbanjpAOp9-Sqfr3x5",
      "type": "text",
      "x": 9321.158690914104,
      "y": 2590.0557109966694,
      "width": 753.539306640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN1v",
      "roundness": null,
      "seed": 1377834695,
      "version": 532,
      "versionNonce": 1871586818,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777165,
      "link": null,
      "locked": false,
      "text": "Here is issue is that if requests on Server1 is low time (eg.10ms per req) and \nrequests on Server2 is long (eg. 10s) so again Server2 have to handle more l\noad so to vercome this we have IP Hash Algorithm",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here is issue is that if requests on Server1 is low time (eg.10ms per req) and \nrequests on Server2 is long (eg. 10s) so again Server2 have to handle more l\noad so to vercome this we have IP Hash Algorithm",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
