    {
      "id": "TtnxST5qoFDr7dCEI5eZX",
      "type": "text",
      "x": 27927.137341819052,
      "y": 1057.1622524043964,
      "width": 1505.01923261272,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
