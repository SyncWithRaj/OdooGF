    {
      "id": "365vBYDZ0fvFir9H2d5Vq",
      "type": "text",
      "x": 17394.76518733848,
      "y": 2417.2242282564775,
      "width": 301.52273246632063,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
