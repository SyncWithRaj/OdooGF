      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777185,
      "link": null,
      "locked": false,
      "text": "Goal: Estimate how much storage Whatsapp needs per day for text messages only",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Goal: Estimate how much storage Whatsapp needs per day for text messages only",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0fd6UjlQHYjwqPaAF8y21",
      "type": "text",
      "x": 29736.54744468712,
      "y": 1376.9411828567552,
      "width": 1397.709716796875,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cNXY",
      "roundness": null,
      "seed": 1866708436,
      "version": 771,
      "versionNonce": 1326471966,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777185,
      "link": null,
      "locked": false,
      "text": "Assumtions:\n1. there are 2 Billion active users daily\n2. each user send 50 messges per day (text msg)\n3. each msg averages 100 Bytes\n4. approximation and roundoffs: 2B * 50 = 100billion msg per day (text msges)\n                                        100B * 100 Bytes = 10^11 * 10^2 = 10^13 bytes per day = 10TB/Day\n                                        10TB/day * 30Days = 300TB/month = 900TB/3 months",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumtions:\n1. there are 2 Billion active users daily\n2. each user send 50 messges per day (text msg)\n3. each msg averages 100 Bytes\n4. approximation and roundoffs: 2B * 50 = 100billion msg per day (text msges)\n                                        100B * 100 Bytes = 10^11 * 10^2 = 10^13 bytes per day = 10TB/Day\n                                        10TB/day * 30Days = 300TB/month = 900TB/3 months",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
