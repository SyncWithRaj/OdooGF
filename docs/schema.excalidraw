      "boundElements": [],
      "updated": 1788587777178,
      "link": null,
      "locked": false,
      "text": "1. User updates data -> Goes to cache.\n2. Cache *Writes it immediately into DB.\n3. Both cache and DB are always in Sync.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "aw20fcALFY6P8A1pLAHM8",
      "originalText": "1. User updates data -> Goes to cache.\n2. Cache *Writes it immediately into DB.\n3. Both cache and DB are always in Sync.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
