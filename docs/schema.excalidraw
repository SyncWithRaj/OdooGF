    {
      "id": "_Wm_-Uks4xabsXizjlK7J",
      "type": "text",
      "x": 12635.913111047883,
      "y": 2366.0531008973303,
      "width": 345.4352578089402,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN81",
      "roundness": null,
      "seed": 2007628013,
      "version": 666,
      "versionNonce": 1100702658,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "IPv4 and IPv6 are Network Layer (Layer 3)\nprotocols responsible for addressing devices\nand routing packets across networks.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IPv4 and IPv6 are Network Layer (Layer 3) protocols responsible for addressing devices and routing packets across networks.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oMVVRjXlpFsdamfGoDQcB",
      "type": "text",
      "x": 13042.109677035989,
      "y": 2367.090709458608,
      "width": 415.40875244140625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN82",
      "roundness": null,
      "seed": 1938261731,
      "version": 465,
      "versionNonce": 1125069150,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "An IP address is like the postal address of a device.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An IP address is like the postal address of a device.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "og8f4vBvXj7X65yNSbqDc",
      "type": "text",
      "x": 13038.532997554143,
      "y": 2420.646519719109,
      "width": 433.6454351340571,
      "height": 170.50064071447562,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN83",
      "roundness": null,
      "seed": 895254989,
      "version": 797,
      "versionNonce": 498965378,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "IPv4\n\nIPv4 (Internet Protocol Version 4) was introduced\nin 1981 and is the most widely used version today.\n\nFormat\n\n32-bit address",
      "fontSize": 17.05006407144756,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IPv4\n\nIPv4 (Internet Protocol Version 4) was introduced in 1981 and is the most widely used version today.\n\nFormat\n\n32-bit address",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
