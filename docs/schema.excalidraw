      "boundElements": [],
      "updated": 1788587777178,
      "link": null,
      "locked": false,
      "text": "1. User updates data -> Goes to cache\n2. Cache *acknowledge success immediately* (fast)\n3.Cache writes chages to DB *later in background\n(ASYNC)*",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "GSf7VTjGAjupANxZAyhfw",
      "originalText": "1. User updates data -> Goes to cache\n2. Cache *acknowledge success immediately* (fast)\n3.Cache writes chages to DB *later in background (ASYNC)*",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
