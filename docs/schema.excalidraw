    {
      "id": "K4uOQq-Qro0rB9vAxGWlK",
      "type": "text",
      "x": 27926.454305656487,
      "y": 1146.2815647825594,
      "width": 1515.3551150264502,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cNVe",
      "roundness": null,
      "seed": 743946046,
      "version": 512,
      "versionNonce": 1896141982,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777184,
      "link": null,
      "locked": false,
      "text": "solution: request stickeyness means u1 req and LB sent it to server1 then whenever it req the LB sent it to server1 so no more redundancy and DB calls\nthat's called request stickeynesss - request stickey ness ko maintain karne k liye hum consistent hashing ki use karte hai jo ek key ka use karti hai wo\nkey kuch bhi ho skti hai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
