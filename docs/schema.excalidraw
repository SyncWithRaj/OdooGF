    {
      "id": "BYUwaCZttw_UDHpK-K9cw",
      "type": "text",
      "x": 17296.74154614508,
      "y": 3947.02602141066,
      "width": 411.65886176469576,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cND5",
      "roundness": null,
      "seed": 1780109069,
      "version": 704,
      "versionNonce": 699443906,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777176,
      "link": null,
      "locked": false,
      "text": "There are some strategy for creating\nshards\n- it depends upon the database\n- sharding can be done through name wise\n(i.e name starts with A are in a shard B\nare in another Shard)\n-  Age based sharding, Geolocation based,\ngender based etc.\n- using sharding or shard key we can\neasily found which data belongs to which\nshard",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are some strategy for creating shards\n- it depends upon the database\n- sharding can be done through name wise (i.e name starts with A are in a shard B are in another Shard)\n-  Age based sharding, Geolocation based, gender based etc.\n- using sharding or shard key we can easily found which data belongs to which shard",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
