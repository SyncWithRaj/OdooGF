      "type": "text",
      "x": 12639.456051823488,
      "y": 2454.1940303507668,
      "width": 372.4789839018431,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
