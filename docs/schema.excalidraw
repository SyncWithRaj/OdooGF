    {
      "id": "Zdn9Qwj9zSzHpkpbqqymc",
      "type": "text",
      "x": 9320.00669086446,
      "y": 2097.092191745678,
      "width": 787.3811465188998,
      "height": 45.84470411291445,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
