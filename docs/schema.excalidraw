      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "server tabhi request(res) karega jab client request\nkarega, server samnese kabhi bhi req nhi karta",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "server tabhi request(res) karega jab client request karega, server samnese kabhi bhi req nhi karta",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pNG_U8jizAw8R72utXGwZ",
      "type": "text",
      "x": 13832.217692633354,
      "y": 1651.4751162944494,
      "width": 402.15950712920494,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN7C",
      "roundness": null,
      "seed": 547760653,
      "version": 1070,
      "versionNonce": 1489435422,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "vigWVjz2krFM7ZP6-a-km",
          "type": "arrow"
        }
      ],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "koi bhi kabhibhi req kar skte hai jab connection\nopen ho. client connection open karne ki req karta\nhai initially. but ek baar conenction ban jaaye to \njaruri nhi ki client har bar req kare server samnese\nbhi res/msg kar skta hai",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "koi bhi kabhibhi req kar skte hai jab connection open ho. client connection open karne ki req karta hai initially. but ek baar conenction ban jaaye to \njaruri nhi ki client har bar req kare server samnese\nbhi res/msg kar skta hai",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
