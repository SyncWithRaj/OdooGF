      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "IPv6 Format\n\nIPv6 was created because IPv4 addresses\nwere running out.\n\n128-bit address",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IPv6 Format\n\nIPv6 was created because IPv4 addresses were running out.\n\n128-bit address",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
