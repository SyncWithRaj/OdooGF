    {
      "id": "Pp6viXnicr8cWg01tPdKM",
      "type": "text",
      "x": 5246.713617202966,
      "y": 529.3035746644064,
      "width": 786.4261305529132,
      "height": 288.63194263267553,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cMso",
      "roundness": null,
      "seed": 954818324,
      "version": 282,
      "versionNonce": 1264765534,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777156,
      "link": null,
      "locked": false,
      "text": "Monolith Architechture\n\nBottle nakes:\n- Deployment \n- Single point of failure\n- individual scaling cause costs increament",
      "fontSize": 38.48425901769007,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Monolith Architechture\n\nBottle nakes:\n- Deployment \n- Single point of failure\n- individual scaling cause costs increament",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "InHgT20ojqIxsQp4u5lyN",
      "type": "rectangle",
      "x": 5236.378711413568,
      "y": 519.796286788267,
      "width": 807.8863232895684,
      "height": 316.64161420471714,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cMsp",
      "roundness": {
        "type": 3
      },
      "seed": 713765908,
      "version": 164,
      "versionNonce": 684462722,
      "isDeleted": true,
