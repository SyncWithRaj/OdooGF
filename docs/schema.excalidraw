    {
      "id": "rQD5eQL1hRHs6Dsqs5bBu",
      "type": "text",
      "x": 11417.215567887253,
      "y": 1420.3630791457936,
      "width": 1090.9254521163266,
      "height": 140.95198723758205,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
