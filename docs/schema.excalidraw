      "seed": 284543949,
      "version": 870,
      "versionNonce": 1066433922,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777175,
      "link": null,
      "locked": false,
      "text": "Dekho Company X k 2 data centers\nhai ek India me ek US me so many\nuser from UK is using that product\nbut UK se user reqq karega to india\nor US k data center pe jayegi so\nLATENCY bahut HIGH ho jayegi to wo\ncompany apne CDNs Deploy karti hai\njaha pe static data store hota hai\naur wahi se serve kiya jata hai if\nnearest CDN me data nhi mila ya error\naye to 2nd nearest CDN se req serve\nki jaati hai agar kahi se req serve na\nho to fir req datacenter se serve hoti\nhai",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dekho Company X k 2 data centers hai ek India me ek US me so many user from UK is using that product but UK se user reqq karega to india or US k data center pe jayegi so LATENCY bahut HIGH ho jayegi to wo company apne CDNs Deploy karti hai jaha pe static data store hota hai  aur wahi se serve kiya jata hai if nearest CDN me data nhi mila ya error aye to 2nd nearest CDN se req serve ki jaati hai agar kahi se req serve na ho to fir req datacenter se serve hoti hai",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
