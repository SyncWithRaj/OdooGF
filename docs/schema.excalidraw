      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP/HTTPS hota hai delievery k liye and\nTCP Hota hai reliable connection establish karne k liye",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jDjSEthDdcMT3IzlGz0Y8",
      "type": "text",
      "x": 14301.827270428977,
      "y": 1665.0655314500834,
      "width": 389.9415865573247,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN7e",
      "roundness": null,
      "seed": 1565913059,
      "version": 521,
      "versionNonce": 618528542,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "HTTPS/HTTP se data send karne se pehle client\nand server k bich me 3 WAY HANDSHAKE hota hai\njiske wajah se reliable connection establish ho",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTPS/HTTP se data send karne se pehle client and server k bich me 3 WAY HANDSHAKE hota hai jiske wajah se reliable connection establish ho",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UH0gkUYGiOfJp4C_ii-Q3",
      "type": "text",
      "x": 14299.368466430256,
      "y": 1750.4901110492451,
      "width": 388.77984068583106,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cN7f",
      "roundness": null,
      "seed": 1367297773,
      "version": 425,
      "versionNonce": 526092738,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777170,
      "link": null,
      "locked": false,
      "text": "This means what? HTTP and HTTPS are TCP\nbased protocols",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This means what? HTTP and HTTPS are TCP based protocols",
