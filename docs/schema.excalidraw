    {
      "id": "LR_H6JyxjGgkJ5OHRJ4Nr",
      "type": "text",
      "x": 29742.803275625378,
      "y": 1327.3059926875555,
      "width": 1126.724609375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cNXX",
      "roundness": null,
      "seed": 778110932,
