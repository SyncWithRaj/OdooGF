      "seed": 488819331,
      "version": 629,
      "versionNonce": 294672670,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "8f8YtVcrXR2Xouomgw5h4",
          "type": "arrow"
        }
      ],
      "updated": 1788587777167,
      "link": null,
      "locked": false,
      "text": "Advantages of Proxy Server:\n- Hides identity of client (IP Anonymility)\n- Access Control (eg. limited site ko access kar skte ho) (School na tab me chrome security hti ee)\n- Grouping ( group the req came on server )\n- Access Restricted Content",
      "fontSize": 22.55231795801314,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Advantages of Proxy Server:\n- Hides identity of client (IP Anonymility)\n- Access Control (eg. limited site ko access kar skte ho) (School na tab me chrome security hti ee)\n- Grouping ( group the req came on server )\n- Access Restricted Content",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1j2U6raA4O_065poZApFi",
      "type": "text",
      "x": 11410.019202608622,
      "y": 2202.7898434038384,
      "width": 851.1403198242188,
      "height": 140.95198723758213,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
