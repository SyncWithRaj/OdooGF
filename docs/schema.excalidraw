    {
      "id": "WZnTVedNni-iXIgJ5cLCf",
      "type": "text",
      "x": 29745.41477015128,
      "y": 1691.6472659495055,
      "width": 1052.3563232421875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
