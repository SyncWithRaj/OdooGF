      "isDeleted": true,
      "boundElements": [],
      "updated": 1788587777178,
      "link": null,
      "locked": false,
      "text": "Lets assume balancer send req 1 to server 1 then data stored in cache\nthen on 2nd req of profile LB send req 2 to server 2 then stored in cache there also\nand req3 goes to 3rd server and updatedProfile by user then new data stores in cache\nof server 3 so there is data inconsistency also and multiple caching also that's hy we \nuse Global Caching",
      "fontSize": 24.137865261002037,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets assume balancer send req 1 to server 1 then data stored in cache\nthen on 2nd req of profile LB send req 2 to server 2 then stored in cache there also\nand req3 goes to 3rd server and updatedProfile by user then new data stores in cache\nof server 3 so there is data inconsistency also and multiple caching also that's hy we \nuse Global Caching",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
